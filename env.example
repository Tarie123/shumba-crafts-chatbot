# ─── Shumba Crafts WhatsApp Chatbot — Environment Variables ───
# Copy this to .env and fill in your values.
# In Railway, add these under the Variables tab (not as a file).

# The token you chose — must match exactly what you enter in Meta webhook form
WHATSAPP_VERIFY_TOKEN=shumbacrafts2024

# Permanent access token from Meta → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=

# Phone Number ID from Meta → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=

# Staff WhatsApp number to receive handoff alerts (with country code, no +)
# e.g. Zimbabwe number: 263772337808
AGENT_WHATSAPP_NUMBER=

# Port (Railway sets this automatically — leave as 3000 for local dev)
PORT=3000
