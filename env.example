# Meta WhatsApp Business Cloud API — copy this file to .env and fill in real values

# Arbitrary string you choose yourself, used when registering the webhook in Meta
VERIFY_TOKEN=your_verify_token_here

# Permanent access token from a Meta System User (Business Settings > System Users)
WHATSAPP_TOKEN=your_whatsapp_permanent_access_token

# From WhatsApp > API Setup in the Meta App dashboard
PHONE_NUMBER_ID=your_phone_number_id

# Staff WhatsApp number to receive handoff/commission notifications, e.g. 263772337808
AGENT_WHATSAPP_NUMBER=263772337808

# Optional, defaults to 3000
PORT=3000
